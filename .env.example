SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182/callback

SCHWAB_TOKEN_PATH=./data/schwab_tokens.json
# Shared application persistence. Leave empty for the existing local SQLite
# backend. For non-local PostgreSQL, include sslmode=require (or verify-ca/full).
SCHWAB_DATABASE_URL=
SCHWAB_STATE_DB_PATH=./data/state.sqlite3
SCHWAB_PAPER_DB_PATH=./data/paper.sqlite3
SCHWAB_AGENT_EVAL_DB_PATH=./data/agent_eval.sqlite3
SCHWAB_RESEARCH_DB_PATH=./data/research.sqlite3
SCHWAB_USAGE_DB_PATH=./data/usage.sqlite3
SCHWAB_SLEEVES_DIR=./data/sleeves
SCHWAB_HISTORY_CACHE_DIR=./data/history_cache
SCHWAB_MARKET_DATA_EVIDENCE_DB_PATH=./data/market_data_evidence.sqlite3
# Historical-replay RESEARCH evidence only; never official cohort evidence.
SCHWAB_HISTORICAL_REPLAY_DB_PATH=./data/historical_replay.sqlite3
# Append-only cohort accounting reviews, operator notes, and keep/modify/pause/
# retire decisions. Used only when SCHWAB_DATABASE_URL is empty; with a shared
# database these records live beside the cohort runs they describe.
SCHWAB_COHORT_REVIEW_DB_PATH=./data/cohort_reviews.sqlite3
SCHWAB_PRICE_PANEL_DB_PATH=./data/prices.sqlite3
SCHWAB_SEC_DB_PATH=./data/sec.sqlite3
SCHWAB_LOG_PATH=./logs/schwab_trader.log
SCHWAB_MIGRATION_BACKUP_DIR=./data/migration-backups

# Official paper-cohort operations (paper-only). Exactly ONE machine may run the
# scheduled cohort job; set this to true only there and leave it unset on every
# read-only dashboard client. It defaults to false so an unconfigured checkout is
# never mistaken for the writer. SCHWAB_COHORT_ID is the cohort the operations
# commands report on; leave it empty to pass --cohort explicitly instead.
SCHWAB_COHORT_WRITER=false
SCHWAB_COHORT_ID=

# SEC EDGAR is free and needs no key, but their fair-access policy asks you to
# identify your traffic. Set this to "Your Name your-email@example.com".
SCHWAB_SEC_USER_AGENT=

SCHWAB_PAPER_STARTING_CASH=5000.00

# Optional: Anthropic API key for the 'llm' agent strategy (console.anthropic.com).
SCHWAB_ANTHROPIC_API_KEY=
SCHWAB_LLM_MODEL=claude-haiku-4-5
SCHWAB_LLM_RESEARCH_MODEL=claude-opus-4-8
SCHWAB_FRED_API_KEY=
SCHWAB_AGENT_UNIVERSE=
SCHWAB_AGENT_MAX_POSITIONS=20
SCHWAB_AGENT_MAX_POSITION_FRACTION=0.10

# Autonomous safety layer (bounded-autonomy gate; rule 14). A present kill-switch
# file halts all autonomous loops. 0 = disabled; set these before any live autonomous use.
SCHWAB_KILL_SWITCH_PATH=./data/KILL_SWITCH
SCHWAB_AGENT_ACTIVITY_DB_PATH=./data/agent_activity.sqlite3
# Strategy validation: a strategy is "validated" when >= this fraction of
# walk-forward folds clear the promotion gates (Sharpe/Calmar/drawdown).
SCHWAB_PROMOTION_DB_PATH=./data/promotion.sqlite3
SCHWAB_PROMOTION_MIN_PASS_RATE=0.6
# Verdict and tested-market-data freshness limit for live/propose authorization.
SCHWAB_PROMOTION_MAX_AGE_DAYS=45
SCHWAB_AGENT_CAPITAL_CAP=0
SCHWAB_AGENT_DAILY_LOSS_LIMIT=0
SCHWAB_AGENT_MAX_TRADES_PER_DAY=0

# Notifications (SMTP email; optional). Used to push proposed orders and alerts
# out-of-band for the notify-and-approve runner. Leave SMTP_HOST/NOTIFY_TO empty
# to disable (nothing is sent). Use an app-specific password, never your main one.
SCHWAB_SMTP_HOST=
SCHWAB_SMTP_PORT=587
SCHWAB_SMTP_USERNAME=
SCHWAB_SMTP_PASSWORD=
SCHWAB_SMTP_USE_TLS=true
SCHWAB_NOTIFY_FROM=
SCHWAB_NOTIFY_TO=

# Notify-and-approve runner: pending approvals + how long a token stays valid.
SCHWAB_APPROVAL_DB_PATH=./data/approvals.sqlite3
SCHWAB_APPROVAL_TTL_MINUTES=60

# Tax-aware execution: local tax-lot ledger for after-tax awareness on the real
# account. TAX_LOT_METHOD is the lot-relief order for gain estimates (FIFO|LIFO|HIFO).
SCHWAB_TAX_LOTS_DB_PATH=./data/taxlots.sqlite3
SCHWAB_TAX_LOT_METHOD=FIFO
SCHWAB_WASH_SALE_WINDOW_DAYS=30

SCHWAB_ACCOUNT_HASH=
SCHWAB_DRY_RUN=true
SCHWAB_TRADING_ENABLED=false
SCHWAB_REQUIRE_CONFIRMATION=true

SCHWAB_MAX_ORDER_QUANTITY=1
SCHWAB_MAX_ORDER_NOTIONAL=100.00
SCHWAB_ALLOWED_SYMBOLS=
SCHWAB_RATE_LIMIT_PER_MINUTE=100
SCHWAB_QUOTE_MAX_AGE_SECONDS=60
SCHWAB_DUPLICATE_WINDOW_SECONDS=300
